{
  "name": "vs-office",
  "displayName": "vs-office",
  "description": "Verwandle VS-Code zu deinem Büro",
  "version": "0.2.0",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vs-office.helloOffice",
        "title": "Hello Office"
      },
      {
        "command": "vs-office.time",
        "title": "Office Time"
      },
      {
        "command": "vs-office.neueTabelle",
        "title": "Neue Tabelle (.xlsx)",
        "category": "Office"
      },
      {
        "command": "vs-office.neuesDiagramm",
        "title": "Neues UML-Diagramm (.uml)",
        "category": "Office"
      }
    ],
    "customEditors": [
      {
        "viewType": "office.pdfEditor",
        "displayName": "Office-PDF-Editor",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ]
      },
      {
        "viewType": "office.sheetEditor",
        "displayName": "Office-Tabellen-Editor",
        "selector": [
          {
            "filenamePattern": "*.xlsx"
          }
        ]
      },
      {
        "viewType": "office.umlEditor",
        "displayName": "Office-UML-Editor",
        "selector": [
          {
            "filenamePattern": "*.uml"
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "json",
        "extensions": [
          ".uml"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "copy-pdfjs": "node scripts/copy-pdfjs.mjs",
    "postinstall": "node scripts/copy-pdfjs.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.137.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@univerjs/presets": "^0.25.1",
    "exceljs": "^4.4.0",
    "pdfjs-dist": "^6.3.289"
  }
}
